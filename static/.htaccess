<IfModule mod_rewrite.c>
  # This block is for all rewrite rules
  RewriteEngine On

  # Compliant with hstspreload.org: first redirect to https if needed
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Then redirect to www. when the prefix wasn't mentioned
  RewriteCond %{HTTP_HOST} !^www\.
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do some permanent redirections
  RedirectPermanent /blog/docker-in-docker-dind/ https://www.avonture.be/blog/docker-out-of-docker-dood
  RedirectPermanent /blog/docker-apache-ssl https://www.avonture.be/blog/docker-localhost-ssl
  RedirectPermanent /resources https://www.avonture.be/repositories

  # Author-only data must never be readable by the public. admin-data/drafts.json
  # lists every draft and unlisted post — slug, title, date, description — which
  # is exactly the set of articles not yet meant to be seen. The deploy step also
  # excludes this folder from the upload; this rule is the second layer, and it
  # keeps covering any copy already sitting on the server.
  RewriteRule ^admin-data/ - [F,L]

  # Sync state written by the FTP deploy action: a full inventory of the server
  # tree. No secret in it, but no reason to publish the map either.
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # Docusaurus-specific rules to handle single-page application routing
  # Note: The RewriteBase is important if your site is in a subdirectory
  RewriteBase /

  # Prevents rewriting of existing files and directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Rewrites all requests to index.html, allowing Docusaurus to handle routing
  RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://scripts.withcabin.com https://matomo.avonture.be; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://matomo.avonture.be https://*.withcabin.com https://api.github.com https://public.api.bsky.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# Serve XSL stylesheets with the correct MIME type so all browsers
# (Chrome, Firefox, Safari) can apply the RSS transformation.
AddType text/xsl .xsl

# Every /blog/<slug>.md mirror and /llms*.txt index (see
# plugins/markdown-export-plugin, TODO 0082) must display inline instead of
# triggering a download — Apache has no built-in mapping for .md.
AddType text/markdown .md

# Cache-forever is only ever correct for a file whose *name* changes when its
# content changes — every one of these carries a content hash, so a new build
# produces a new URL and no reader can be served a stale copy.
#
# `json` deliberately absent: not one of the JSON files this site emits is
# content-hashed. questions-index.json, blog/feed.json and
# pagefind/pagefind-entry.json all keep a fixed name while their content changes
# on every build, so `immutable` told returning visitors to keep last year's copy
# for a year. For pagefind-entry.json that silently breaks search — the stale
# entry file points at index chunks whose names no longer exist.
<FilesMatch "\.(js|css|png|jpg|webp|svg|woff|woff2|ttf|xsl)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML files, their plain-Markdown mirrors, and the non-hashed JSON indexes
# shouldn't be cached so a reader always gets the version from the latest build.
<FilesMatch "\.(html|md|json)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Add gzip compression
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/xsl text/css application/javascript text/markdown
