# Disable directory browsing for all directories without an index file.
Options -Indexes

<IfModule mod_rewrite.c>
  # This block is for all rewrite rules
  RewriteEngine On

  # Compliant with hstspreload.org: first redirect to https if needed
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Then redirect to www. when the prefix wasn't mentioned
  RewriteCond %{HTTP_HOST} !^www\.
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do some permanent redirections
  RedirectPermanent /blog/docker-in-docker-dind/ https://www.avonture.be/blog/docker-out-of-docker-dood
  RedirectPermanent /blog/docker-apache-ssl https://www.avonture.be/blog/docker-localhost-ssl
  RedirectPermanent /resources https://www.avonture.be/repositories

  # Francophone browsers land on the French site.
  #
  # A visitor whose browser announces French FIRST is sent to /fr/<the same page>. Posed on
  # 2026-09-17, the day the corpus reached 257/257 translated — never before: until then this
  # rule pushed French readers off a canonical URL onto a page `plugins/i18n-seo-guard`
  # deliberately marks `noindex`, only to serve them the very same English prose. See TODO 0124.
  #
  # Every condition below is a guardrail, not decoration:
  #
  #  1. `!^/fr(/|$)` — build/fr/.htaccess is a byte-for-byte copy of this file (Docusaurus copies
  #     static/ into every locale) and Apache applies the nearest one, so without this the French
  #     copy would redirect /fr/blog/x to /fr/fr/blog/x, forever. This same condition is what makes
  #     that copy inert. `.github/workflows/deploy.yml` asserts the line survives, for each locale.
  #  2. `REDIRECT_STATUS` empty — a reader's own request only, never the internal subrequest that
  #     serves `ErrorDocument 404` further down.
  #  3. No `locale` cookie — the language dropdown writes one on an explicit choice, see
  #     `src/theme/NavbarItem/LocaleDropdownNavbarItem/`. Without it, a French-speaking reader who
  #     switches to English is dragged back to /fr/ on their very next click, and the back button
  #     pushes them forward again.
  #  4. French FIRST in Accept-Language (`fr`, `fr-FR`, `fr-BE`…) — not a browser that merely
  #     accepts French after English. Googlebot crawls with no Accept-Language at all, so no
  #     crawler ever meets this rule.
  #  5. HTML only. A last path segment carrying an extension is an asset, a feed, an `.md` mirror,
  #     llms.txt, robots.txt, sitemap.xml, questions-index.json, manifest.webmanifest or sw.js —
  #     redirecting those breaks subscribed feed readers and the agent discoverability built in
  #     TODO 0082. The directory exclusion covers the extensionless files those trees may hold.
  #
  # 302, never 301: a permanent redirect is cached by the browser almost for good and cannot be
  # taken back six months later.
  RewriteCond %{REQUEST_URI} !^/fr(/|$)
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)locale=
  RewriteCond %{HTTP:Accept-Language} ^fr\b [NC]
  RewriteCond %{REQUEST_URI} !^/(api|assets|pagefind|img|files|admin-data|llms)/
  RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]+$
  RewriteRule ^ /fr%{REQUEST_URI} [R=302,L,E=LOCALE_REDIRECT:1]

  # Sync state written by the FTP deploy action: a full inventory of the server
  # tree. No secret in it, but no reason to publish the map either.
  RewriteRule ^\.ftp-deploy-sync-state\.json$ - [F,L]

  # Docusaurus pre-renders its routes to files, so the classic "rewrite
  # everything to index.html" SPA fallback caught almost nothing real — it just
  # made this site answer 200 to every URL on earth. That is a soft 404: Google
  # treats it as a quality signal, and no dead-link checker can work against a
  # server that never says no.
  #
  # What survives of it is this narrow safety net for the two route families
  # that are generated rather than authored — the tag pages and the series
  # pages, registered by plugins/docusaurus-plugin-tag-route and
  # plugins/docusaurus-plugin-series-route. Whether those plugins register one
  # parameterized route or one route per slug is an implementation detail that
  # has changed before; this rule is written to be correct either way. When a
  # per-slug file exists in the build, the two conditions below fail and Apache
  # serves that file directly — the rule never fires. It only takes over when
  # the file is missing, which is exactly the case where the React router still
  # knows how to render the page and a 404 would be wrong.
  #
  # Deliberately one path segment only. `/blog/tags/tags/<slug>` is the blog
  # plugin's own listing and a real directory, and `/blog/tags/a/b` is not a
  # route at all — both must fall through to the 404 below.
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(series|blog/tags)/[^/]+/?$ /index.html [L]
</IfModule>

# Anything that reached this point is neither a file on disk nor one of the two
# client-side routes above: it does not exist, and the server must say so with a
# real 404 status. Docusaurus already builds `404.html` from the theme, so the
# reader gets the site's own styled error page rather than Apache's grey default.
ErrorDocument 404 /404.html

# Security headers
<IfModule mod_headers.c>
  # admin-data/drafts.json backs the "Pending drafts" panel of /admin, so it has
  # to be readable — the page cannot report what it is not allowed to fetch. It
  # lists posts under blog/ carrying `draft: true` or `unlisted: true`: articles
  # already committed but deliberately held back, so their titles are not secret,
  # just early. What it must not do is end up in a search index, hence noindex
  # rather than the blanket 403 that used to sit here.
  <FilesMatch "^drafts\.json$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>

  # The redirect above is negotiated on Accept-Language, so no intermediate cache may hand one
  # visitor's 302 to the next. The HTML itself is already `no-store`, but the redirect is a
  # separate response — and it is the one that would be reused.
  Header always set Vary "Accept-Language" env=LOCALE_REDIRECT

  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://scripts.withcabin.com https://matomo.avonture.be; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://matomo.avonture.be https://*.withcabin.com https://api.github.com https://public.api.bsky.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# Serve XSL stylesheets with the correct MIME type so all browsers
# (Chrome, Firefox, Safari) can apply the RSS transformation.
AddType text/xsl .xsl

# Every /blog/<slug>.md mirror and /llms*.txt index (see
# plugins/markdown-export-plugin, TODO 0082) must display inline instead of
# triggering a download — Apache has no built-in mapping for .md.
AddType text/markdown .md
AddCharset utf-8 .md

# Without this, Apache serves manifest.webmanifest as the generic
# application/octet-stream, and Chrome silently ignores a manifest whose
# Content-Type it doesn't recognize — no install prompt, no error either.
AddType application/manifest+json .webmanifest

# Cache-forever is only ever correct for a file whose *name* changes when its
# content changes — every one of these carries a content hash, so a new build
# produces a new URL and no reader can be served a stale copy.
#
# `json` deliberately absent: not one of the JSON files this site emits is
# content-hashed. questions-index.json, blog/feed.json and
# pagefind/pagefind-entry.json all keep a fixed name while their content changes
# on every build, so `immutable` told returning visitors to keep last year's copy
# for a year. For pagefind-entry.json that silently breaks search — the stale
# entry file points at index chunks whose names no longer exist. `webmanifest` is
# absent for the same reason: manifest.webmanifest keeps a fixed name too (TODO 0090).
<FilesMatch "\.(js|css|png|jpg|webp|svg|woff|woff2|ttf|xsl)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HTML files, their plain-Markdown mirrors, the non-hashed JSON indexes, and the
# web app manifest shouldn't be cached so a reader always gets the version from
# the latest build.
<FilesMatch "\.(html|md|json|webmanifest)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# sw.js (TODO 0095) keeps a fixed name like the files above, but the generic ".js" rule
# would otherwise catch it under the *immutable* block instead — a service worker cached
# for a year is worse than a stale JSON file: it would pin a reader to a year-old asset
# list with no way for the reload popup to ever offer the update that fixes it. This
# `<Files>` block is more specific than the `<FilesMatch>` one above and comes after it, so
# for this one file its Cache-Control overrides the generic ".js" rule.
<Files "sw.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# Add gzip compression
AddOutputFilterByType DEFLATE text/html text/plain text/xml text/xsl text/css application/javascript text/markdown
