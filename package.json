{
  "name": "opt-docusaurus",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "DOCUSAURUS_GENERATED_FILES_DIR_NAME=.docusaurus-dev docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear && rm -rf .docusaurus-dev",
    "serve": "docusaurus serve --host 0.0.0.0",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "eli5": "node scripts/generate-eli5.mjs",
    "eli5:bulk": "node scripts/bulk-eli5.mjs",
    "eli5:check": "node scripts/check-eli5-freshness.mjs",
    "questions": "node scripts/generate-questions.mjs",
    "questions:bulk": "node scripts/generate-questions.mjs --all",
    "questions:check": "node scripts/check-questions-freshness.mjs",
    "questions:edit": "node scripts/faq-edit.mjs",
    "questions:review": "node scripts/questions-review.mjs",
    "questions:list": "node scripts/questions-review.mjs --list",
    "questions:status": "node scripts/questions-review.mjs --status",
    "icons:bundle": "node scripts/generate-icon-bundle.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "colors:bundle": "node scripts/generate-post-colors.mjs",
    "links:audit": "node scripts/internal-link-opportunities.mjs --stats",
    "links:check": "node scripts/internal-link-opportunities.mjs --post",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --max-warnings 350",
    "lint": "yarn lint:js && yarn lint:css",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/plugin-ideal-image": "^3.10.2",
    "@docusaurus/plugin-pwa": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@iconify-json/bi": "^1.2.7",
    "@iconify-json/codicon": "^1.2.63",
    "@iconify-json/devicon": "^1.2.62",
    "@iconify-json/devicon-plain": "^1.2.57",
    "@iconify-json/file-icons": "^1.2.2",
    "@iconify-json/fluent": "^1.2.52",
    "@iconify-json/hugeicons": "^1.2.30",
    "@iconify-json/ix": "^1.2.11",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/skill-icons": "^1.2.4",
    "@iconify-json/tabler": "^1.2.35",
    "@iconify-json/uil": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.66",
    "@iconify/react": "^6.0.2",
    "@iconify/utils": "^3.1.4",
    "@mdx-js/react": "^3.0.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.0.0",
    "d3-force": "^3.0.0",
    "docusaurus-plugin-image-zoom": "^3.0.1",
    "docusaurus-plugin-pagefind": "^0.2.2",
    "feed": "^5.1.0",
    "front-matter": "^4.0.2",
    "glob": "^13.0.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "pagefind": "^1.5.2",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-medium-image-zoom": "^5.4.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.5.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "github-slugger": "^1.5.0",
    "globals": "^17.7.0",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
