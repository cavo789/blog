# Dependencies
/node_modules
/.yarn

# Production
/build

# Generated files
.docusaurus
# `yarn start`'s own copy of the above, kept separate so a concurrent `yarn build` can never
# race it while regenerating shared codegen — see package.json's `start` script.
.docusaurus-dev
.cache-loader

# Misc
/.env
/api/.env

/*.log*

*/**/*:Zone.Identifier

**/__pycache__/**

# Claude Code TODO session locks (ephemeral, never commit)
.todos/.locks/

# AnythingLLM indexing state (local to each machine, holds no secret)
.anythingllm-indexed

# rumdl (ad hoc `npx rumdl` markdown lint checks) — cache is redirected to
# /tmp via RUMDL_CACHE_DIR (see .devcontainer/devcontainer.json); this entry
# is just a safety net should it ever be created here anyway.
.rumdl_cache/
