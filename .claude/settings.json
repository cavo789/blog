{
  "permissions": {
    "allow": [
      "Bash(convert *)",
      "Bash(curl *)",
      "Bash(echo \"Started PID $!\")",
      "Bash(identify *)",
      "Bash(kill 44)",
      "Bash(netstat -tlnp)",
      "Bash(node -e ' *)",
      "Bash(node /opt/docusaurus/node_modules/.bin/playwright --version)",
      "Bash(npm list *)",
      "Bash(npm root *)",
      "Bash(npm run *)",
      "Bash(npx --yes playwright *)",
      "Bash(timeout 60 bash -c 'until curl -s http://localhost:3000 -o /dev/null -w \"%{http_code}\" 2>/dev/null | grep -q \"200\"; do sleep 2; done && echo \"Server ready\"')",
      "Read(//home/**)",
      "Read(//root/**)",
      "Read(//usr/**)"
    ],
    "additionalDirectories": ["/tmp"]
  }
}
