OS_USERID=1000
OS_GROUPID=1000

# This key is used by the .scripts/python_tldr script to access
# the Gemini API. Replace the value below with your actual API key.
# You can get an API key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=xxxxxx

# Key to create on platform.claude.com
ANTHROPIC_API_KEY=xxxxxx

# This host maps AnythingLLM to 3200, not its default 3001, so the port-probe
# in .scripts/anythingllm-*.sh can't auto-discover it. Pin the URL explicitly.
ANYTHINGLLM_URL=http://172.17.0.1:3200

ANYTHINGLLM_API_KEY=xxxxxx

# Read by the GitHub CLI (`gh`) to follow CI runs and read their logs from the devcontainer.
# Fine-grained token on github.com/settings/personal-access-tokens, repository cavo789/blog only,
# permission "Actions: Read-only" (add "Contents: Read-only" if gh asks for it). Nothing else.
GH_TOKEN=xxxxxx
