/.docusaurus
# Same class as the above: `yarn start`'s own codegen dir and the throwaway pair written
# by safe_build.sh's isolated verification build (see .claude/rules/build-verification.md).
# No COPY ever reads them; excluding them keeps BuildKit from stat-ing and hashing
# ~3600 extra files (174 MB) on every build-context scan.
/.docusaurus-dev
/.docusaurus-verify
/build-verify
/build
/node_modules

.git/
.env
.env*
.ssh/
id_rsa*
id_ed25519*
id_ecdsa*
.aws/
.netrc
.npmrc
.pypirc
*.p12
*.pfx
localhost.pem
localhost-key.pem

.config/
.devcontainer/
!.devcontainer/docker-entrypoint.sh
!.devcontainer/scripts/interactive.sh
# …and the command modules it sources — see the COPY in the Dockerfile.
!.devcontainer/scripts/helpers
!.devcontainer/scripts/helpers/*.sh
.vscode/
.editorconfig
.github/
.claude/
.todos/
.scripts/
.tools/
.unpublished/
.aiexclude
.prettierignore
.prettierrc.json
.stylelintrc.json
eslint.config.mjs

.gitignore
.dockerignore
CLAUDE.md
AGENTS.md
README.md
LICENSE
makefile
compose.yaml
compose*.yaml
Dockerfile
Dockerfile*

nginx.conf.eli5.json
