{
  // Options for markdownlint-cli2 itself (see the "check" command in bash_helpers.sh).
  // Linting rules live in .markdownlint.json and are reused via "extends"
  // so there is a single source of truth for the rules.
  "config": {
    "extends": "./.markdownlint.json",
  },
  "noBanner": true,
  "noProgress": true,
}
